# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git. Never commit a real key.

# Required. Create one in ElevenLabs under Developers, API keys.
ELEVENLABS_API_KEY=

# Optional. Pick any voice ID you can use in your account.
# ELEVENLABS_VOICE_ID=

# Optional. Defaults to eleven_multilingual_v2.
# ELEVENLABS_MODEL_ID=
